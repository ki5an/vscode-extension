{
  "name": "vscode-extension",
  "displayName": "VS Code Extension",
  "description": "Custom UI enhancements and styling for Visual Studio Code.",
  "version": "1.0.0",
  "publisher": "ki5an",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscodeExtension.apply",
        "title": "VS Code Extension: Apply"
      },
      {
        "command": "vscodeExtension.restore",
        "title": "VS Code Extension: Restore"
      }
    ],
    "configuration": {
      "title": "VS Code Extension",
      "properties": {
        "vscodeExtension.rowHeight": {
          "type": "number",
          "default": 32,
          "minimum": 20,
          "maximum": 60,
          "description": "Height of Explorer file and folder rows in pixels."
        }
      }
    }
  }
}